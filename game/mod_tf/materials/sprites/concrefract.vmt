// FF Grenade Port: refraction overlay for conceffect.mdl.
// concrefract.vmt was in FF's shipped VPK under sprites/ but not in public repos.
// Stand-in: subtle additive blue glow until the original is sourced.
"UnlitGeneric"
{
	"$basetexture"		"vgui/white_additive"
	"$translucent"		"1"
	"$alpha"			"0.08"
	"$color2"			"[0.3 0.5 1]"
	"$additive"			"1"
	"$nocull"			"1"
}
